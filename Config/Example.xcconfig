// Copy to Config/Local.xcconfig and fill in, then set it as the project's
// configuration file in Xcode (or pass -xcconfig on the command line).
//
// Both values below are publishable: the anon key is safe in a client precisely
// because row level security decides what it can read. A service-role key must
// never appear here or anywhere else in the app.
//
// Leaving these empty is a supported build. The schedule, the widget, and the
// whole of milestones 1 through 3 work with no backend at all.

SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY =

// Base64 Ed25519 public key that signs the shared rotation file. Generated by
// Tools/sign_rotation.py --generate-key.
ROTATION_PUBLIC_KEY =
